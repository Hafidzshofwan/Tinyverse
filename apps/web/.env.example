# ============================================================
#  RAHASIA SERVER — JANGAN diberi awalan NEXT_PUBLIC_
# ============================================================
# Variabel berawalan NEXT_PUBLIC_ ikut dikirim ke browser dan bisa dibaca
# siapa saja. Tiga nilai di bawah berasal dari service account Firebase
# (Firebase Console > Project settings > Service accounts > Generate new
# private key), dan memberi kewenangan PENUH atas proyek Anda.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Salin apa adanya termasuk BEGIN/END. Di Vercel, tempel dalam satu baris
# dengan \n sebagai pemisah baris — kode sudah menanganinya.
FIREBASE_PRIVATE_KEY=

# ============================================================
#  Konfigurasi publik Firebase (aman terbaca browser)
# ============================================================
# Nilai-nilai ini memang dirancang untuk publik; yang melindungi data adalah
# Firestore Security Rules, bukan kerahasiaan nilai ini.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================
#  Midtrans (RAHASIA SERVER)
# ============================================================
# "sandbox" untuk uji coba, "production" untuk uang sungguhan.
MIDTRANS_MODE=sandbox

# Server Key dari dashboard Midtrans: Settings > Access Keys.
# JANGAN pernah memberinya awalan NEXT_PUBLIC_. Kunci ini setara kata sandi
# penuh atas akun pembayaran: pemegangnya bisa membuat dan membatalkan
# transaksi atas nama Anda.
MIDTRANS_SERVER_KEY=

# Client Key dari tempat yang sama: Settings > Access Keys.
# Kunci ini memang dirancang untuk terbaca publik — snap.js membutuhkannya di
# browser untuk memunculkan jendela pembayaran. Meski begitu ia sengaja TIDAK
# diberi awalan NEXT_PUBLIC_: nilainya dibaca Server Component lalu diturunkan
# sebagai prop, supaya mode sandbox/production hanya hidup di satu tempat dan
# tidak bisa berbeda antara server dan browser.
#
# Boleh dikosongkan. Bila kosong, tombol beli otomatis kembali ke cara lama,
# yaitu mengalihkan pelanggan ke halaman pembayaran milik Midtrans.
MIDTRANS_CLIENT_KEY=

# Alamat dasar aplikasi, tanpa garis miring di ujung. Dipakai menyusun URL
# kepulangan setelah pelanggan selesai membayar.
# Lokal   : http://localhost:3000
# Produksi: https://tinyverse-web.vercel.app
APP_BASE_URL=http://localhost:3000

# ============================================================
#  Asisten AI — Google Gemini (RAHASIA SERVER)
# ============================================================
# Kunci API dari Google AI Studio: aistudio.google.com > Get API key.
# JANGAN pernah memberinya awalan NEXT_PUBLIC_. Kunci ini ditagihkan ke akun
# Google Anda: siapa pun yang memegangnya bisa memakai kuota atas nama Anda.
# Nilainya hanya dibaca di apps/web/src/app/api/chat/route.ts, yang berjalan
# di peladen, sehingga tidak pernah ikut terkirim ke browser.
#
# Boleh dikosongkan saat pengembangan lokal. Bila kosong, Asisten AI menjawab
# dengan pesan bahwa layanan sedang tidak tersedia; fitur lain tetap berjalan.
GEMINI_API_KEY=

# ============================================================
#  Tugas berkala / cron (RAHASIA SERVER)
# ============================================================
# Kata sandi bebas yang Anda tentukan sendiri, cukup panjang dan acak.
# Dipakai untuk memastikan rute rekonsiliasi pembayaran hanya boleh dipanggil
# oleh penjadwal cron Vercel, bukan oleh siapa pun di internet. Nilai yang
# sama harus dipasang di Environment Variables pada proyek Vercel.
#
# Bila nilai ini pernah bocor atau pernah tercatat di tempat yang dapat
# dibaca orang lain, ganti dengan nilai baru lalu deploy ulang.
CRON_SECRET=
